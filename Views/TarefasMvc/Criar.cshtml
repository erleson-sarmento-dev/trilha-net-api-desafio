@model TrilhaApiDesafio.Models.Tarefa
@{
    ViewData["Title"] = "Nova Tarefa";
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        <div class="card main-card p-4 p-md-5">
            <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                <div>
                    <h3 class="fw-bold mb-1">Cadastrar Nova Tarefa</h3>
                    <p class="text-muted small mb-0">Preencha as informações abaixo para adicionar à sua lista</p>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Voltar
                </a>
            </div>

            <form asp-action="Criar" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Titulo" class="form-label fw-semibold">Título <span class="text-danger">*</span></label>
                    <input asp-for="Titulo" class="form-control" placeholder="Ex: Estudar Entity Framework Core" required autofocus />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label fw-semibold">Descrição</label>
                    <textarea asp-for="Descricao" rows="4" class="form-control" placeholder="Detalhes opcionais sobre esta tarefa..."></textarea>
                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Data" class="form-label fw-semibold">Data e Hora <span class="text-danger">*</span></label>
                        <input asp-for="Data" type="datetime-local" class="form-control" value="@Model.Data.ToString("yyyy-MM-ddTHH:mm")" required />
                        <span asp-validation-for="Data" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label fw-semibold">Status Inicial</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<TrilhaApiDesafio.Models.EnumStatusTarefa>()">
                        </select>
                        <span asp-validation-for="Status" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary-custom text-white px-4">
                        <i class="bi bi-check-lg me-1"></i> Salvar Tarefa
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
