@model IEnumerable<TrilhaApiDesafio.Models.Tarefa>
@{
    ViewData["Title"] = "Listagem de Tarefas";
    string currentTitulo = ViewBag.SearchTitulo as string ?? "";
    string currentData = ViewBag.SearchData as string ?? "";
    var currentStatus = ViewBag.SearchStatus as TrilhaApiDesafio.Models.EnumStatusTarefa?;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1">Minhas Tarefas</h2>
        <p class="text-muted mb-0">Gerencie suas atividades diárias e acompanhe seu progresso</p>
    </div>
    <a asp-action="Criar" class="btn btn-primary-custom text-white d-inline-flex align-items-center gap-2 px-3 py-2 rounded-3 shadow-sm">
        <i class="bi bi-plus-lg"></i>
        <span>Adicionar Tarefa</span>
    </a>
</div>

<!-- Filtros de Busca (atendendo ObterPorTitulo, ObterPorData, ObterPorStatus) -->
<div class="card main-card mb-4 p-3 border-0">
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label small fw-semibold text-muted">Buscar por Título</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="searchTitulo" value="@currentTitulo" class="form-control border-start-0" placeholder="Digite o título..." />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Filtrar por Data</label>
            <input type="date" name="searchData" value="@currentData" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-semibold text-muted">Status</label>
            <select name="searchStatus" class="form-select">
                <option value="">Todos os status</option>
                <option value="Pendente" selected="@(currentStatus == TrilhaApiDesafio.Models.EnumStatusTarefa.Pendente ? "selected" : null)">Pendente</option>
                <option value="Finalizado" selected="@(currentStatus == TrilhaApiDesafio.Models.EnumStatusTarefa.Finalizado ? "selected" : null)">Finalizado</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-1">
                <i class="bi bi-funnel"></i> Filtrar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Limpar filtros">
                <i class="bi bi-arrow-clockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Tabela de Tarefas -->
<div class="card main-card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small text-uppercase">
                <tr>
                    <th scope="col" style="width: 70px;" class="ps-4">#ID</th>
                    <th scope="col">Título</th>
                    <th scope="col">Descrição</th>
                    <th scope="col">Data</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end pe-4" style="width: 180px;">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var tarefa in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted">#@tarefa.Id</td>
                            <td>
                                <span class="fw-semibold text-dark">@tarefa.Titulo</span>
                            </td>
                            <td>
                                <span class="text-muted text-truncate d-inline-block" style="max-width: 300px;">
                                    @(string.IsNullOrWhiteSpace(tarefa.Descricao) ? "—" : tarefa.Descricao)
                                </span>
                            </td>
                            <td>
                                <span class="small text-muted d-flex align-items-center gap-1">
                                    <i class="bi bi-calendar3"></i>
                                    @tarefa.Data.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </td>
                            <td>
                                @if (tarefa.Status == TrilhaApiDesafio.Models.EnumStatusTarefa.Finalizado)
                                {
                                    <span class="badge-finalizado small">
                                        <i class="bi bi-check-circle"></i> Finalizado
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pendente small">
                                        <i class="bi bi-clock-history"></i> Pendente
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a asp-action="Detalhes" asp-route-id="@tarefa.Id" class="btn btn-outline-secondary" title="Ver Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Editar" asp-route-id="@tarefa.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Deletar" asp-route-id="@tarefa.Id" class="btn btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="py-4">
                                <i class="bi bi-inbox text-muted display-4 d-block mb-3"></i>
                                <h5 class="fw-semibold text-secondary">Nenhuma tarefa encontrada</h5>
                                <p class="text-muted small">Crie uma nova tarefa ou ajuste os filtros de pesquisa.</p>
                                <a asp-action="Criar" class="btn btn-primary-custom btn-sm text-white px-3 py-2 rounded-pill mt-2">
                                    <i class="bi bi-plus-lg me-1"></i> Criar Primeira Tarefa
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="card-footer bg-white border-0 py-3 ps-4 text-muted small">
            Total de tarefas exibidas: <strong>@Model.Count()</strong>
        </div>
    }
</div>
